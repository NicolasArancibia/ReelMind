# Variables admitidas por el backend. Este archivo NO se carga automáticamente.
# Los scripts usan la credencial cifrada local; no necesitan una copia .env.
# Para ejecución manual, exportar variables en el entorno del proceso.
# Puertos de esta entrega: API 8000 e interfaz 5180, solo en 127.0.0.1.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=reelmind
PGUSER=reelmind_app
PGPASSWORD=
REELMIND_PROCESSING_AUTOSTART=false
REELMIND_MAX_HEAVY_TASKS=1
# Ruta absoluta fuera de OneDrive. Los scripts usan runtime.DataRoot o runtime/data.
# REELMIND_DATA_ROOT=D:\ReelMindData
REELMIND_MAX_UPLOAD_BYTES=2147483648
# Audio local: small en CPU int8, 4 hilos. Preparación explícita con prepare-audio.ps1.
REELMIND_WHISPER_MODEL=small
REELMIND_AUDIO_TIMEOUT_SECONDS=7200
# Supabase y los demás proveedores de IA esperan sus fases.
