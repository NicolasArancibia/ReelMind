# Contrato propuesto. Todavía no hay una aplicación que cargue este archivo.
# Copiar a .env cuando se cree el backend. Nunca incluir contraseñas reales aquí.
REELMIND_ENV=development
REELMIND_HOST=127.0.0.1
REELMIND_API_PORT=8000
REELMIND_FRONTEND_PORT=5173
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=reelmind
PGUSER=reelmind_app
PGPASSWORD=
# Ruta absoluta local, fuera de OneDrive; definir al preparar almacenamiento.
REELMIND_DATA_DIR=
REELMIND_BACKUP_DIR=
REELMIND_PROCESSING_AUTOSTART=false
REELMIND_MAX_HEAVY_TASKS=1
# Supabase y proveedores de IA se configurarán en sus respectivas fases.
